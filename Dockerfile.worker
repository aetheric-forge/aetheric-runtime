FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/Tools/Aetheric.Provisioning.Worker/Aetheric.Provisioning.Worker.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
COPY --from=build /app/publish .
ENV Provisioning__DataDirectory=/data
ENV Provisioning__SecretsKeyDirectory=/data/secrets-key
ENTRYPOINT ["dotnet", "Aetheric.Provisioning.Worker.dll"]
